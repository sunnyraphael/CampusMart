NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test
PAYSTACK_LIVE_ENABLED=0
# Random server-only value, at least 32 characters. Used by the scheduled worker.
CRON_SECRET=
CAMPUSMART_TRIAL_CHECKOUT=0
NEXT_PUBLIC_APP_URL=http://localhost:3000
WHATSAPP_NUMBER=

# Optional: configure the matching Turnstile secret in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Backup encryption key: 64 random hex characters. Keep a separate secure copy.
BACKUP_ENCRYPTION_KEY=
# Session/direct database URL for pg_dump only; never use a public prefix.
BACKUP_DATABASE_URL=

# Optional: only behind an ingress that overwrites this header and protects the origin.
# x-vercel-forwarded-for or cf-connecting-ip; leave blank for ordinary localhost.
CAMPUSMART_TRUSTED_IP_HEADER=
